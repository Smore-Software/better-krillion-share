{
  "manifest_version": 3,
  "name": "Share Kit for Krillion",
  "version": "0.1.0",
  "description": "Unofficial. Share your Krillion daily dive with answers, questions, percentile, spoiler tags and an image card.",
  "homepage_url": "https://github.com/Smore-Software/better-krillion-share",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://krillion.io/*"],
      "js": ["src/share-text.js", "src/dive-data.js", "src/card.js", "src/panel.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
